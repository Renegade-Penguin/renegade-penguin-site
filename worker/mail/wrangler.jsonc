{
  // Mail Worker for the contact form. Deployed as renegade-penguin-mail
  // (uploaded 2026-11-19, no public address). Email Sending domain onboarding and a live send test
  // are still pending (issue #35); see docs/mail-worker.md.
  // No routes, workers_dev off and preview URLs off: the only caller is the Pages project,
  // through a service binding named MAIL_WORKER.
  "name": "renegade-penguin-mail",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "contact@renegadepenguinllc.com"
    }
  ],
  "vars": {
    // The sender must be on a domain onboarded to Cloudflare Email Service. That onboarding is
    // currently pending (issue #35).
    "MAIL_FROM": "noreply@renegadepenguinllc.com"
  }
}
